---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{%- set projectIds = [] -%}
{%- for p in collections.projects -%}
  {%- if p.data.lang == "fr" -%}{%- set projectIds = (projectIds.push(p.data.id), projectIds) -%}{%- endif -%}
{%- endfor -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>{{ site.baseUrl }}/</loc>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ site.baseUrl }}/"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.baseUrl }}/en/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.baseUrl }}/"/>
    <lastmod>{{ buildDate }}</lastmod>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ site.baseUrl }}/en/</loc>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ site.baseUrl }}/"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.baseUrl }}/en/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.baseUrl }}/"/>
    <lastmod>{{ buildDate }}</lastmod>
    <priority>0.9</priority>
  </url>
{%- for id in projectIds %}
  <url>
    <loc>{{ site.baseUrl }}/projects/{{ id }}/</loc>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ site.baseUrl }}/projects/{{ id }}/"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.baseUrl }}/en/projects/{{ id }}/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.baseUrl }}/projects/{{ id }}/"/>
    <lastmod>{{ buildDate }}</lastmod>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ site.baseUrl }}/en/projects/{{ id }}/</loc>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ site.baseUrl }}/projects/{{ id }}/"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ site.baseUrl }}/en/projects/{{ id }}/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ site.baseUrl }}/projects/{{ id }}/"/>
    <lastmod>{{ buildDate }}</lastmod>
    <priority>0.7</priority>
  </url>
{%- endfor %}
</urlset>
