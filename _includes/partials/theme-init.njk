{# Resolves the theme before first paint, so the page never flashes the wrong one. #}
<script>
  (function () {
    var stored = null;
    // Le stockage de site peut lever (navigation privée, cookies bloqués) :
    // on l'isole pour que l'échec ne coûte pas la préférence système.
    try {
      stored = localStorage.getItem("theme");
    } catch (e) {}

    var system = "light";
    try {
      if (window.matchMedia("(prefers-color-scheme: dark)").matches) system = "dark";
    } catch (e) {}

    var theme = stored === "light" || stored === "dark" ? stored : system;

    document.documentElement.setAttribute("data-theme", theme);

    // Les vignettes à variante claire sont choisies par <picture>, donc sur la
    // seule préférence système. Quand un choix explicite la contredit, il faut
    // corriger les sources pendant l'analyse du document : après le premier
    // rendu, la mauvaise image aurait déjà été peinte.
    if (theme === system) return;

    function retarget() {
      var sources = document.querySelectorAll("source[data-theme-source]");
      for (var i = 0; i < sources.length; i++) {
        sources[i].media =
          sources[i].getAttribute("data-theme-source") === theme ? "all" : "not all";
      }
    }

    var observer = new MutationObserver(retarget);
    observer.observe(document.documentElement, { childList: true, subtree: true });
    document.addEventListener(
      "DOMContentLoaded",
      function () {
        retarget();
        observer.disconnect();
      },
      { once: true },
    );
  })();
</script>
