{# Contact affordances of the home page's blue block. #}
{% import "partials/icons.njk" as icon %}

{# Email first, as one button that copies it; then every other channel. #}
{% macro contactBlock(t, site) %}
  <button class="mail" type="button" data-copy="{{ site.email }}" data-copy-kind="email" title="{{ t.a11y.copyEmail }}">
    <span class="mail__address">{{ site.email }}</span>
    <span class="mail__action">{{ icon.copy(14) }}<span class="mail__label">{{ t.contact.copy }}</span></span>
  </button>

  <div class="contact__row">
    <a class="btn btn--on-block" href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">
      {{ t.contact.linkedinBtn }}{{ icon.arrowUpRight(14) }}
    </a>
    <a class="btn btn--on-block" href="{{ site.github }}" target="_blank" rel="noopener noreferrer">
      {{ t.contact.githubBtn }}{{ icon.arrowUpRight(14) }}
    </a>
    <a class="btn btn--block-solid" href="{{ t.hero.cvUrl }}" target="_blank" rel="noopener noreferrer">
      {{ t.contact.cvBtn }}{{ icon.download(14) }}
    </a>
    <button class="contact__phone" type="button" data-copy="{{ site.phone }}" data-copy-kind="phone" title="{{ t.a11y.copyPhone }}">
      <span class="visually-hidden">{{ t.contact.phoneLabel }} : </span>{{ site.phoneDisplay }}{{ icon.copy(13) }}
    </button>
  </div>
{% endmacro %}
