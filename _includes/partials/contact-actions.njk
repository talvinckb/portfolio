{# Contact affordances. Two shapes: the hero's action row, the contact panel. #}
{% import "partials/icons.njk" as icon %}

{# ─── Hero: one accent action, one outlined, then icon links ─── #}
{% macro heroActions(t, site, anchorBase) %}
  <div class="actions">
    <a href="{{ anchorBase }}#work" class="btn btn--accent">
      <span>{{ t.hero.ctaWork }}</span>{{ icon.arrowRight(16) }}
    </a>

    <a href="{{ anchorBase }}#contact" class="btn btn--line">
      <span>{{ t.hero.ctaContact }}</span>
    </a>

    <a href="{{ site.github }}" class="btn btn--line btn--icon" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
      {{ icon.github(18) }}
    </a>

    <a href="{{ site.linkedin }}" class="btn btn--line btn--icon" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn">
      {{ icon.linkedin(18) }}
    </a>
  </div>
{% endmacro %}

{# ─── Contact section: email first, then every other channel ─── #}
{% macro contactBlock(t, site) %}
  <div class="reach">
    <div class="reach__primary">
      <a class="reach__email" href="mailto:{{ site.email }}">
        {{ icon.mail(18) }}<span>{{ site.email }}</span>
      </a>
      <button class="reach__copy" type="button" data-copy="{{ site.email }}" data-copy-kind="email" aria-label="{{ t.a11y.copyEmail }}" title="{{ t.a11y.copyEmail }}">
        {{ icon.copy(14) }}<span>{{ t.contact.copy }}</span>
      </button>
    </div>

    <div class="reach__row">
      <a class="reach__phone" href="tel:{{ site.phone }}">
        <span class="reach__label">{{ t.contact.phoneLabel }}</span>{{ site.phoneDisplay }}
      </a>
      <button class="reach__copy reach__copy--quiet" type="button" data-copy="{{ site.phone }}" data-copy-kind="phone" aria-label="{{ t.a11y.copyPhone }}" title="{{ t.a11y.copyPhone }}">
        {{ icon.copy(14) }}
      </button>
    </div>

    <ul class="reach__links" role="list">
      <li>
        <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">
          {{ t.contact.linkedinBtn }}{{ icon.arrowUpRight(14) }}
        </a>
      </li>
      <li>
        <a href="{{ site.github }}" target="_blank" rel="noopener noreferrer">
          {{ t.contact.githubBtn }}{{ icon.arrowUpRight(14) }}
        </a>
      </li>
      <li>
        <a href="{{ t.hero.cvUrl }}" target="_blank" rel="noopener noreferrer">
          {{ t.contact.cvBtn }}{{ icon.download(14) }}
        </a>
      </li>
    </ul>
  </div>
{% endmacro %}
