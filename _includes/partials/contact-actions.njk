{# Contact affordances of the home page's blue block. #}
{% import "partials/icons.njk" as icon %}

{# Email first: the pill writes to me, its end copies the address; then
   every other channel. The address is only in the page encoded
   (`mailKey`), decoded on click. #}
{% macro contactBlock(t, site) %}
  <div class="mail">
    <a class="mail__link" href="{{ t.urlPrefix }}#contact" data-mail="{{ site.email | mailKey }}">{{ icon.mail(22) }}<span>{{ t.contact.emailCta }}</span></a>
    <button class="mail__action" type="button" data-mail="{{ site.email | mailKey }}" title="{{ t.a11y.copyEmail }}">
      {{ icon.copy(14) }}<span class="mail__label">{{ t.contact.copy }}</span>
    </button>
  </div>

  <div class="contact__row">
    <a class="btn btn--on-block" href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">
      {{ t.contact.linkedinBtn }}{{ icon.arrowUpRight(14) }}
    </a>
    <a class="btn btn--on-block" href="{{ site.github }}" target="_blank" rel="noopener noreferrer">
      {{ t.contact.githubBtn }}{{ icon.arrowUpRight(14) }}
    </a>
    <a class="btn btn--block-solid" href="{{ t.hero.cvUrl }}" target="_blank" rel="noopener noreferrer">
      {{ t.contact.cvBtn }}{{ icon.download(14) }}
    </a>
  </div>
{% endmacro %}
