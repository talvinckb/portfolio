{#
  Icon macros — single source of truth for every inline SVG on the site.
  All icons share the Feather 24x24 stroke grid.
  Decorative by default: aria-hidden + focusable="false".
#}

{% macro _svg(paths, size, cls) %}<svg xmlns="http://www.w3.org/2000/svg" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="{{ cls }}" aria-hidden="true" focusable="false">{{ paths | safe }}</svg>{% endmacro %}

{% macro mail(size=16, cls="icon") %}{{ _svg('<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>', size, cls) }}{% endmacro %}

{% macro linkedin(size=16, cls="icon") %}{{ _svg('<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>', size, cls) }}{% endmacro %}

