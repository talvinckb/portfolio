{% set t = fr if lang == 'fr' else en %}
{% set frUrl = "/projects/" + id + "/" %}
{% set enUrl = "/en/projects/" + id + "/" %}
{% set pageTitle = name + " — " + title + " | " + site.name %}
{% set pageDescription = tagline %}
{% set pageUrl = site.baseUrl + page.url %}
{% set pageType = "article" %}
{% set anchorBase = t.urlPrefix %}
{% set homeUrl = t.urlPrefix %}
{% set altUrl = enUrl if lang == 'fr' else frUrl %}

{% set thumb = thumbnail | default("/assets/projects/placeholder.webp") %}
{% set thumbLight = thumbnailLight | default(thumb) %}
{% set pageImage = site.baseUrl + thumb %}
{% set pageImageAlt = t.a11y.projectPreview + " " + name %}
{% set pageImageWidth = 1280 %}
{% set pageImageHeight = 720 %}

{% set projectLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": name + " — " + title,
  "headline": title,
  "abstract": tagline,
  "url": pageUrl,
  "image": pageImage,
  "inLanguage": lang,
  "author": { "@type": "Person", "name": site.name, "url": site.baseUrl + t.urlPrefix },
  "keywords": stack | join(", "),
  "isPartOf": { "@type": "WebSite", "name": site.name, "url": site.baseUrl }
} %}

{% import "partials/icons.njk" as icon %}

<!DOCTYPE html>
<html lang="{{ lang }}" data-theme="dark">
  <head>
    <script>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored !== "light" && stored !== "dark") {
            stored = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
          }
          document.documentElement.setAttribute("data-theme", stored);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
    {% include "partials/head.njk" %}

    <!-- KaTeX — math rendering, loaded only on project pages -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" crossorigin="anonymous"/>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js" crossorigin="anonymous"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" crossorigin="anonymous"></script>
  </head>

  <body>
    {% include "partials/nav.njk" %}

    <main id="main" class="project-page">
      <div class="project-page__back container">
        <a href="{{ anchorBase }}#projects" class="project-back-link">
          {{ icon.chevronLeft() }}{{ "Back to projects" if lang == 'en' else "Retour aux projets" }}
        </a>
      </div>

      <header class="project-hero">
        <div class="container project-hero__inner">
          <div class="project-hero__meta">
            <span class="project-badge">{{ name }}</span>
            {% if period %}
              <span class="project-hero__period">{{ icon.clock() }}{{ period }}</span>
            {% endif %}
            {% if team %}
              <span class="project-hero__team">
                {{ icon.users() }}{{ team }} {{ "people" if lang == 'en' else "pers." }}
              </span>
            {% endif %}
          </div>

          <h1 class="project-hero__title">{{ title }}</h1>
          <p class="project-hero__tagline">{{ tagline }}</p>

          {% if stack %}
            <ul class="project-hero__stack tag-list" role="list">
              {% for s in stack %}
                <li class="tag tag--static">{{ s }}</li>
              {% endfor %}
            </ul>
          {% endif %}

          {% if github or demo or report %}
            <div class="project-hero__links">
              {% if github %}
                <a href="{{ github }}" target="_blank" rel="noopener noreferrer" class="btn btn--outline">
                  {{ icon.github() }}<span>{{ "Source code" if lang == 'en' else "Code source" }}</span>
                </a>
              {% endif %}
              {% if demo %}
                <a href="{{ demo }}" target="_blank" rel="noopener noreferrer" class="btn btn--primary">
                  {{ icon.externalLink() }}<span>{{ "Demo" if lang == 'en' else "Démo" }}</span>
                </a>
              {% endif %}
              {% if report %}
                <a href="{{ report }}" target="_blank" rel="noopener noreferrer" class="btn btn--outline">
                  {{ icon.download() }}<span>{{ "PDF report" if lang == 'en' else "Rapport PDF" }}</span>
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </header>

      <div class="project-thumbnail container">
        <img
          src="{{ thumb }}"
          data-src-dark="{{ thumb }}"
          data-src-light="{{ thumbLight }}"
          alt="{{ t.a11y.projectPreview }} {{ name }}"
          class="project-thumbnail__img"
          width="1280" height="720"
          fetchpriority="high" decoding="async"/>
      </div>

      <article class="project-content container">
        {{ content | safe }}
      </article>

      <nav class="project-footer-nav container" aria-label="{{ t.nav.projects }}">
        <a href="{{ anchorBase }}#projects" class="btn btn--outline">
          {{ icon.chevronLeft() }}<span>{{ "All projects" if lang == 'en' else "Tous les projets" }}</span>
        </a>
        <a href="{{ anchorBase }}#contact" class="btn btn--primary">
          {{ icon.mail() }}<span>{{ t.contact.title }}</span>
        </a>
      </nav>
    </main>

    {% include "partials/footer.njk" %}

    <script type="module" src="/js/project.js"></script>
  </body>
</html>
