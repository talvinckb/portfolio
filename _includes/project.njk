{% set t = fr if lang == 'fr' else en %}
{% set frUrl = "/projects/" + id + "/" %}
{% set enUrl = "/en/projects/" + id + "/" %}
{% set pageTitle = name + " — " + title + " | " + site.name %}
{% set pageDescription = tagline %}
{% set pageUrl = site.baseUrl + page.url %}
{% set pageType = "article" %}
{% set anchorBase = t.urlPrefix %}
{% set homeUrl = t.urlPrefix %}
{% set altUrl = enUrl if lang == 'fr' else frUrl %}
{% set readingProgress = true %}

{% set thumb = thumbnail | default("/assets/projects/placeholder.webp") %}
{% set thumbLight = thumbnailLight | default(thumb) %}
{% set pageImage = site.baseUrl + thumb %}
{% set pageImageAlt = t.a11y.projectPreview + " " + name %}
{% set pageImageWidth = 1280 %}
{% set pageImageHeight = 720 %}

{% set projectLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": name + " — " + title,
  "headline": title,
  "abstract": tagline,
  "url": pageUrl,
  "image": pageImage,
  "inLanguage": lang,
  "author": { "@type": "Person", "name": site.name, "url": site.baseUrl + t.urlPrefix },
  "keywords": stack | join(", "),
  "isPartOf": { "@type": "WebSite", "name": site.name, "url": site.baseUrl }
} %}

{% import "partials/icons.njk" as icon %}

<!DOCTYPE html>
<html lang="{{ lang }}" data-theme="light">
  <head>
    <script>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored !== "light" && stored !== "dark") {
            stored = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          document.documentElement.setAttribute("data-theme", stored);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    {% include "partials/head.njk" %}

    <!-- KaTeX — math rendering, loaded only on project pages -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" crossorigin="anonymous"/>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js" crossorigin="anonymous"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" crossorigin="anonymous"></script>
  </head>

  <body>
    {% include "partials/nav.njk" %}

    <main id="main" class="case">
      <header class="case__head wrap">
        <a href="{{ anchorBase }}#work" class="case__back">
          {{ icon.chevronLeft(14) }}{{ t.project.back }}
        </a>

        <p class="case__eyebrow">{{ name }}</p>
        <h1 class="case__title">{{ title }}</h1>
        <p class="case__tagline">{{ tagline }}</p>

        <dl class="case__facts">
          {% if period %}
            <div class="case__fact">
              <dt>{{ t.project.duration }}</dt>
              <dd>{{ period }}</dd>
            </div>
          {% endif %}
          {% if team %}
            <div class="case__fact">
              <dt>{{ t.project.teamLabel }}</dt>
              <dd>{{ team }} {{ t.project.team }}</dd>
            </div>
          {% endif %}
          {% if stack %}
            <div class="case__fact case__fact--wide">
              <dt>{{ t.project.stackLabel }}</dt>
              <dd>{{ stack | join(" / ") }}</dd>
            </div>
          {% endif %}
        </dl>

        {% if github or demo or report %}
          <div class="actions">
            {% if demo %}
              <a href="{{ demo }}" target="_blank" rel="noopener noreferrer" class="btn btn--fill">
                {{ icon.externalLink(15) }}<span>{{ t.project.demo }}</span>
              </a>
            {% endif %}
            {% if github %}
              <a href="{{ github }}" target="_blank" rel="noopener noreferrer" class="btn btn--line">
                {{ icon.github(15) }}<span>{{ t.project.sourceCode }}</span>
              </a>
            {% endif %}
            {% if report %}
              <a href="{{ report }}" target="_blank" rel="noopener noreferrer" class="btn btn--line">
                {{ icon.download(15) }}<span>{{ t.project.report }}</span>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </header>

      <div class="case__cover wrap">
        <img
          src="{{ thumb }}"
          data-src-dark="{{ thumb }}"
          data-src-light="{{ thumbLight }}"
          alt="{{ t.a11y.projectPreview }} {{ name }}"
          class="case__cover-img"
          width="1280" height="720"
          fetchpriority="high" decoding="async"/>
      </div>

      <article class="prose wrap">
        {{ content | safe }}
      </article>

      <nav class="case__nav wrap" aria-label="{{ t.nav.work }}">
        <a href="{{ anchorBase }}#work" class="btn btn--line">
          {{ icon.chevronLeft(15) }}<span>{{ t.project.back }}</span>
        </a>
        <a href="mailto:{{ site.email }}" class="btn btn--fill">
          {{ icon.mail(15) }}<span>{{ t.project.contactCta }}</span>
        </a>
      </nav>
    </main>

    {% include "partials/footer.njk" %}

    <script type="module" src="/js/project.js"></script>
  </body>
</html>
