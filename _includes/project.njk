{% set t = fr if lang == 'fr' else en %}
{% set frUrl = "/projects/" + id + "/" %}
{% set enUrl = "/en/projects/" + id + "/" %}
{% set pageTitle = name + " — " + title + " | " + site.name %}
{% set pageDescription = tagline %}
{% set pageUrl = site.baseUrl + page.url %}
{% set pageType = "article" %}
{% set anchorBase = t.urlPrefix %}
{% set homeUrl = t.urlPrefix %}
{% set altUrl = enUrl if lang == 'fr' else frUrl %}
{% set readingProgress = true %}

{% set thumb = thumbnail | default("/assets/projects/placeholder.webp") %}
{% set thumbLight = thumbnailLight | default(thumb) %}
{% set pageImage = site.baseUrl + thumb %}
{% set pageImageAlt = t.a11y.projectPreview + " " + name %}
{% set pageImageWidth = 1280 %}
{% set pageImageHeight = 720 %}

{% set sections = content | toc %}
{% set pager = t.projects.items | neighbours(id) %}

{% set projectLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": name + " — " + title,
  "headline": title,
  "abstract": tagline,
  "url": pageUrl,
  "image": pageImage,
  "inLanguage": lang,
  "author": { "@type": "Person", "name": site.name, "url": site.baseUrl + t.urlPrefix },
  "keywords": stack | join(", "),
  "isPartOf": { "@type": "WebSite", "name": site.name, "url": site.baseUrl }
} %}

{% import "partials/icons.njk" as icon %}

<!DOCTYPE html>
<html lang="{{ lang }}">
  <head>
    {% include "partials/theme-init.njk" %}
    {% include "partials/head.njk" %}

    <!-- KaTeX — math rendering, loaded only on project pages -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" crossorigin="anonymous"/>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js" crossorigin="anonymous"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js" crossorigin="anonymous"></script>
  </head>

  <body>
    {% include "partials/nav.njk" %}

    <main id="main" class="case">
      <header class="case-head wrap">
        <div class="case-head__text">
          <a href="{{ anchorBase }}#work" class="case-head__back">
            {{ icon.chevronLeft(14) }}{{ t.project.back }}
          </a>
          <p class="case-head__eyebrow">{{ t.project.eyebrow }} · {{ name }}</p>
          <h1 class="case-head__title">{{ title }}</h1>
          <p class="case-head__tagline">{{ tagline }}</p>

          {# One ruled line of metadata, label above value. #}
          <dl class="facts">
            {% if period %}
              <div class="facts__item">
                <dt>{{ t.project.duration }}</dt>
                <dd>{{ period }}</dd>
              </div>
            {% endif %}
            {% if team %}
              <div class="facts__item">
                <dt>{{ t.project.teamLabel }}</dt>
                <dd>{{ team }} {{ t.project.team }}</dd>
              </div>
            {% endif %}
            {% if stack %}
              <div class="facts__item facts__item--stack">
                <dt>{{ t.project.stackLabel }}</dt>
                <dd>{{ stack | join(" · ") }}</dd>
              </div>
            {% endif %}
          </dl>

          {% if github or demo or report %}
            <div class="actions">
              {% if demo %}
                <a href="{{ demo }}" target="_blank" rel="noopener noreferrer" class="btn btn--accent">
                  {{ icon.externalLink(15) }}<span>{{ t.project.demo }}</span>
                </a>
              {% endif %}
              {% if github %}
                <a href="{{ github }}" target="_blank" rel="noopener noreferrer" class="btn btn--line">
                  {{ icon.github(15) }}<span>{{ t.project.sourceCode }}</span>
                </a>
              {% endif %}
              {% if report %}
                <a href="{{ report }}" target="_blank" rel="noopener noreferrer" class="btn btn--line">
                  {{ icon.download(15) }}<span>{{ t.project.report }}</span>
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </header>

      <div class="case-body wrap">
        {% if sections | length %}
          <nav class="toc" aria-label="{{ t.project.toc }}">
            <p class="label">{{ t.project.toc }}</p>
            <ol class="toc__list" role="list">
              {% if brief %}
                <li><a href="#brief">{{ t.project.briefTitle }}</a></li>
              {% endif %}
              {% for s in sections %}
                <li><a href="#{{ s.id }}">{{ s.text | safe }}</a></li>
              {% endfor %}
            </ol>
          </nav>
        {% endif %}

        <div class="case-body__main">
          <figure class="viewer case-cover">
            <div class="viewer__frame">
              <img
                src="{{ thumb }}"
                data-src-dark="{{ thumb }}"
                data-src-light="{{ thumbLight }}"
                alt="{{ t.a11y.projectPreview }} {{ name }}"
                class="case-cover__img"
                width="1280" height="720"
                fetchpriority="high" decoding="async"/>
            </div>
          </figure>

          {% if brief %}
            <section class="brief" id="brief" aria-labelledby="brief-title">
              <h2 class="visually-hidden" id="brief-title">{{ t.project.briefTitle }}</h2>
              <div class="brief__cell">
                <h3 class="label">{{ t.project.problem }}</h3>
                <p>{{ brief.problem }}</p>
              </div>
              <div class="brief__cell">
                <h3 class="label">{{ t.project.approach }}</h3>
                <p>{{ brief.approach }}</p>
              </div>
              <div class="brief__cell brief__cell--result">
                <h3 class="label">{{ t.project.result }}</h3>
                <p>{{ brief.result }}</p>
              </div>
              {% if brief.role %}
                <div class="brief__cell">
                  <h3 class="label">{{ t.project.role }}</h3>
                  <p>{{ brief.role }}</p>
                </div>
              {% endif %}
            </section>
          {% endif %}

          <article class="prose">
            {{ content | safe }}
          </article>
        </div>
      </div>

      <div class="wrap">
        <nav class="pager" aria-label="{{ t.nav.work }}">
          {% if pager.prev %}
            <a href="{{ t.urlPrefix }}projects/{{ pager.prev.id }}/" class="pager__link" rel="prev">
              <span class="label">{{ icon.chevronLeft(12) }}{{ t.project.prev }}</span>
              <span class="pager__title">{{ pager.prev.name }}</span>
              <span class="pager__sub">{{ pager.prev.title }}</span>
            </a>
          {% else %}
            <a href="{{ anchorBase }}#work" class="pager__link">
              <span class="label">{{ icon.chevronLeft(12) }}{{ t.project.backShort }}</span>
              <span class="pager__title">{{ t.project.back }}</span>
            </a>
          {% endif %}

          {% if pager.next %}
            <a href="{{ t.urlPrefix }}projects/{{ pager.next.id }}/" class="pager__link pager__link--next" rel="next">
              <span class="label">{{ t.project.next }}{{ icon.arrowRight(12) }}</span>
              <span class="pager__title">{{ pager.next.name }}</span>
              <span class="pager__sub">{{ pager.next.title }}</span>
            </a>
          {% else %}
            <a href="mailto:{{ site.email }}" class="pager__link pager__link--next">
              <span class="label">{{ t.contact.label }}{{ icon.arrowRight(12) }}</span>
              <span class="pager__title">{{ t.project.contactCta }}</span>
            </a>
          {% endif %}
        </nav>
      </div>
    </main>

    {% include "partials/footer.njk" %}

    <script type="module" src="/js/project.js"></script>
  </body>
</html>
