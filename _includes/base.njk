{% set t = fr if lang == 'fr' else en %}
{% set pageTitle = t.meta.title %}
{% set pageDescription = t.meta.description %}
{% set pageUrl = site.baseUrl + t.urlPrefix %}
{% set pageImage = site.baseUrl + ((t.meta.ogImage | default(site.ogImage)) | versioned) %}
{% set pageImageAlt = t.meta.ogImageAlt %}
{% set pageType = "website" %}
{% set anchorBase = "" %}
{% set homeUrl = t.urlPrefix %}
{% set altUrl = t.altUrl %}

{% set featured = t.projects.items | selectattr("featured") %}
{% set others = t.projects.items | rejectattr("featured") %}
{% set count = featured | length %}

{% import "partials/icons.njk" as icon %}
{% import "partials/contact-actions.njk" as contact %}

{# Two-digit index: 1 → "01". #}
{% macro two(n) %}{{ "0" if n < 10 }}{{ n }}{% endmacro %}

{# The name is set like a logotype, its letters tight enough to touch.
   They stay inline, so the font's own kerning still applies between them.
   Each letter rises on its own; the second line starts while the first is
   still moving. #}
{% macro nameLines(name) -%}
  {%- for word in name.split(" ") -%}
    {%- set line = loop.index0 -%}
    <span class="hero__line">
      {%- for ch in word.split("") -%}
        <span class="hero__ch" style="--i: {{ loop.index0 + line * 4 }}">{{ ch }}</span>
      {%- endfor -%}
    </span>
  {%- endfor -%}
{%- endmacro %}

<!DOCTYPE html>
<html lang="{{ lang }}">
  <head>
    {% include "partials/theme-init.njk" %}
    {% include "partials/head.njk" %}
  </head>

  <body>
    {% include "partials/nav.njk" %}

    <main id="main">
      <!-- ─── Hero ─── -->
      <section class="hero wrap" aria-labelledby="hero-name">
        <div class="hero__meta">
          <p>{{ t.hero.role }}</p>
          <p class="status">
            <span class="status__dot" aria-hidden="true"></span>
            <span class="status__long">{{ t.hero.status }}</span>
            <span class="status__short">{{ t.hero.statusShort }}</span>
          </p>
        </div>

        {# Screen readers get the plain name. The copy beside the heading is
           the lens: the same letters in outline, shown only under the
           pointer, as an edge detector would see them (main.js). It stays
           out of the h1, which holds the name once. #}
        <div class="hero__name" data-lens>
          <h1 class="hero__solid" id="hero-name">
            <span class="visually-hidden">{{ t.hero.name }}</span>
            <span aria-hidden="true">{{ nameLines(t.hero.name) }}</span>
          </h1>
          <span class="hero__lens" aria-hidden="true">{{ nameLines(t.hero.name) }}</span>
        </div>

        <div class="hero__row">
          <p class="hero__lead"><strong>{{ t.hero.leadStrong }}</strong> {{ t.hero.lead }}</p>
          <div class="actions">
            <a href="#work" class="btn btn--accent">{{ t.hero.ctaWork }}{{ icon.arrowDown(16, "icon icon--down") }}</a>
            <a href="#contact" class="btn btn--line">{{ t.hero.ctaContact }}</a>
          </div>
        </div>
      </section>

      <!-- ─── Work ─── -->
      <section id="work" class="section wrap" aria-labelledby="work-title">
        <div class="section__head">
          <h2 class="section__title" id="work-title">{{ t.projects.title }}<sup class="section__count">{{ two(count) }}</sup></h2>
          {# Only on small screens, where the cards become a carousel. #}
          <div class="stack-nav" data-stack-nav hidden>
            <button class="stack-nav__btn" type="button" data-dir="-1" aria-label="{{ t.a11y.prevProject }}" aria-controls="stack">{{ icon.chevronLeft(18) }}</button>
            <button class="stack-nav__btn" type="button" data-dir="1" aria-label="{{ t.a11y.nextProject }}" aria-controls="stack">{{ icon.chevronRight(18) }}</button>
          </div>
        </div>

        {# Cards stack as the page scrolls on large screens, main.js shrinking
           the one being covered; on small screens they scroll sideways. #}
        <div class="stack" id="stack" data-stack data-cursor-label="{{ t.projects.cursor }}">
          {% for p in featured %}
            {% set projectUrl = t.urlPrefix + "projects/" + p.id + "/" %}
            <article class="card" id="p-{{ p.id }}" style="--i: {{ loop.index0 }}" aria-labelledby="card-{{ p.id }}">
              <div class="card__inner">
                <div class="card__text">
                  <p class="card__meta">
                    <span class="card__index">
                      <button class="card__step" type="button" data-step="-1" aria-label="{{ t.a11y.prevProject }}" title="{{ t.a11y.prevProject }} (←)"{% if loop.first %} disabled{% endif %}>{{ icon.chevronLeft(14) }}</button>
                      <span><b>{{ two(loop.index) }}</b> / {{ two(count) }}</span>
                      <button class="card__step" type="button" data-step="1" aria-label="{{ t.a11y.nextProject }}" title="{{ t.a11y.nextProject }} (→)"{% if loop.last %} disabled{% endif %}>{{ icon.chevronRight(14) }}</button>
                    </span>
                    <span>{{ p.period }} · {{ t.projects.pair if p.team == 2 else t.projects.teamOf + " " + p.team }}</span>
                  </p>
                  <p class="card__name">{{ p.name }}</p>
                  <h3 class="card__title" id="card-{{ p.id }}">{{ p.title }}</h3>
                  <p class="card__tagline">{{ p.tagline | highlight(p.highlights) | safe }}</p>
                  <ul class="tags" role="list">
                    {% for s in p.stack %}<li>{{ s }}</li>{% endfor %}
                  </ul>
                  <div class="card__links">
                    <a class="btn btn--ink" href="{{ projectUrl }}">{{ t.projects.read }}{{ icon.arrowRight(16, "icon icon--right") }}</a>
                    {% if p.github %}
                      <a class="link" href="{{ p.github }}" target="_blank" rel="noopener noreferrer">{{ t.projects.sourceCode }}{{ icon.arrowUpRight(13) }}</a>
                    {% endif %}
                  </div>
                </div>

                {# The visual repeats the case-study link for the pointer only. #}
                <a class="card__media" href="{{ projectUrl }}" tabindex="-1" aria-hidden="true" data-cursor>
                  {# The light variant is chosen at parse time: swapping it in JS
                     after the first paint would make the visual flash. #}
                  <picture>
                    <source
                      data-theme-source="light"
                      media="(prefers-color-scheme: light)"
                      srcset="{{ (p.thumbnailLight | default(p.thumbnail)) | versioned }}"/>
                    <img
                      src="{{ p.thumbnail | versioned }}"
                      alt=""
                      width="1600" height="900"
                      loading="lazy" decoding="async"/>
                  </picture>
                </a>
              </div>
            </article>
          {% endfor %}
        </div>

        {# The rest of the work, smaller: in columns on a wide screen, in a
           row to scroll sideways on a phone. #}
        <div class="others">
          <h3 class="others__head label">{{ t.projects.secondaryTitle }}<span class="others__count">{{ two(others | length) }}</span></h3>
          <ul class="others__list" role="list">
            {% for p in others %}
              <li class="other">
                <h4 class="other__name">{{ p.name }}</h4>
                <p class="other__tagline">{{ p.tagline }}</p>
                {% if p.repoNote %}<p class="other__note">{{ p.repoNote }}</p>{% endif %}
                <p class="other__stack">{{ p.stack | join(" · ") }}</p>
                {% if p.github %}
                  <a class="link" href="{{ p.github }}" target="_blank" rel="noopener noreferrer">{{ t.projects.publicRepo }}{{ icon.arrowUpRight(13) }}</a>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>
      </section>

      <!-- ─── Background ─── -->
      {# Most recent first, drawn as a branch graph: the studies are the
         trunk, everything else forks off it and merges back. main.js draws
         the lines from the dates; without JavaScript the list stands alone.
         What is past, current or planned is decided at build time. #}
      {% set now = buildDate.slice(0, 7) %}
      {% set timeline = t.background.timeline %}
      <section id="background" class="section wrap" aria-labelledby="background-title">
        <h2 class="section__title" id="background-title">{{ t.background.title }}</h2>

        <div class="path">
          <div class="path__aside">
            <p class="path__lede">{{ t.background.lede }}</p>

            <div class="path__extras">
              <p class="label">{{ t.background.extrasTitle }}</p>
              <ul role="list">
                {% for item in t.background.extras %}<li>{{ item }}</li>{% endfor %}
              </ul>
            </div>
          </div>

          <div class="tl" data-tl>
            <ol class="tl__list" role="list">
              {% for item in timeline %}
                {% set prev = timeline[loop.index0 - 1] if not loop.first else null %}
                {% if item.start <= now and (not prev or prev.start > now) %}
                  <li class="tl__now" data-start="{{ now }}"><span class="tl__now-label" data-tl-dot>{{ t.background.today }}</span></li>
                {% endif %}

                {% if item.start > now %}{% set state = "next" %}
                {% elif not item.end or item.end >= now %}{% set state = "live" %}
                {% else %}{% set state = "past" %}{% endif %}
                {% set when = item.period.split(" — ") %}

                {% set head %}
                  <span class="tl__when"><span>{{ when[0] }}</span>{% if when[1] %}<span>{{ when[1] }}</span>{% endif %}</span>
                  <h3 class="tl__org" data-tl-dot>{{ item.org }}</h3>
                  <span class="tl__role">{{ item.role }}</span>
                  <span class="tl__side">
                    {% if state == "live" %}
                      <span class="badge badge--live"><span class="badge__dot" aria-hidden="true"></span><span class="badge__text">{{ t.background.now }}</span></span>
                    {% else %}
                      <span class="badge{% if state == 'next' %} badge--next{% endif %}">{{ item.type }}</span>
                    {% endif %}
                  </span>
                {% endset %}

                <li class="tl__item is-{{ state }}" id="tl-{{ item.id }}" data-start="{{ item.start }}" data-end="{{ item.end or '' }}"{% if item.trunk %} data-trunk{% endif %}>
                  {% if item.description or item.tags %}
                    <details class="tl__card">
                      <summary class="tl__head">
                        {{ head | safe }}
                        <span class="tl__toggle" aria-hidden="true">{{ icon.plus(14) }}</span>
                      </summary>
                      <div class="tl__body">
                        {% if item.description %}<p class="tl__desc">{{ item.description }}</p>{% endif %}
                        {% if item.tags %}
                          <ul class="tl__tags" role="list">
                            {% for tag in item.tags %}<li>{{ tag }}</li>{% endfor %}
                          </ul>
                        {% endif %}
                        {% if item.link %}<a class="link" href="{{ item.link.href }}">{{ item.link.label }}{{ icon.arrowRight(13) }}</a>{% endif %}
                      </div>
                    </details>
                  {% else %}
                    <div class="tl__card">
                      <div class="tl__head">{{ head | safe }}</div>
                      {% if item.link %}
                        <div class="tl__body"><a class="link" href="{{ item.link.href }}">{{ item.link.label }}{{ icon.arrowRight(13) }}</a></div>
                      {% endif %}
                    </div>
                  {% endif %}
                </li>
              {% endfor %}
            </ol>
          </div>
        </div>
      </section>

      <!-- ─── Skills ─── -->
      {# Every skill against the work it served in: a dot where it was used.
         Pointing at a cell lights its row and its column (main.js); each
         column header leads to its project or to its line in the path. On a
         phone the matrix scrolls sideways under its sticky skill names. #}
      {% set columns = t | skillColumns %}
      <section id="skills" class="section wrap" aria-labelledby="skills-title">
        <h2 class="section__title" id="skills-title">{{ t.skills.title }}</h2>

        <div class="skills matrix" data-matrix>
          <table class="matrix__table">
            <caption class="visually-hidden">{{ t.skills.caption }}</caption>
            <thead>
              <tr>
                <td class="matrix__corner"></td>
                {% for col in columns %}
                  <th class="matrix__col{% if col.opens %} opens{% endif %}" scope="col" data-col="{{ loop.index0 }}">
                    {% if col.href %}
                      <a class="matrix__name" href="{{ col.href }}"{% if col.external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ col.name }}</a>
                    {% else %}
                      <span class="matrix__name">{{ col.name }}</span>
                    {% endif %}
                  </th>
                {% endfor %}
              </tr>
            </thead>
            {% for group in t.skills.groups %}
              <tbody>
                <tr class="matrix__group">
                  <th scope="rowgroup" colspan="{{ columns | length + 1 }}"><span class="label">{{ group.category }}</span></th>
                </tr>
                {% for item in group.items %}
                  <tr class="matrix__row">
                    <th class="matrix__skill" scope="row">{{ item.name }}</th>
                    {% for col in columns %}
                      {% if col.id in item.used %}
                        <td class="is-used{% if col.opens %} opens{% endif %}" data-col="{{ loop.index0 }}"><span class="matrix__dot" aria-hidden="true"></span><span class="visually-hidden">{{ t.skills.used }}</span></td>
                      {% else %}
                        <td{% if col.opens %} class="opens"{% endif %} data-col="{{ loop.index0 }}"></td>
                      {% endif %}
                    {% endfor %}
                  </tr>
                {% endfor %}
              </tbody>
            {% endfor %}
          </table>
        </div>

        {# On a phone the matrix could only scroll sideways: the skills turn
           into pills, each with the number of works it served in, and a tap
           lists those works under the group (main.js). #}
        <div class="skills skillset" data-skillset>
          {% for group in t.skills.groups %}
            {% set g = loop.index0 %}
            <div class="skillset__group">
              <h3 class="label">{{ group.category }}</h3>
              <ul class="skillset__pills" role="list">
                {% for item in group.items %}
                  <li>
                    <button class="skillset__pill" type="button" aria-expanded="false" aria-controls="uses-{{ g }}-{{ loop.index0 }}">
                      {{ item.name }}<span class="skillset__count" aria-hidden="true">{{ item.used | length }}</span>
                    </button>
                  </li>
                {% endfor %}
              </ul>
              {% for item in group.items %}
                <div class="skillset__uses" id="uses-{{ g }}-{{ loop.index0 }}" hidden>
                  <p class="skillset__lead">{{ item.name }}<span> · {{ t.skills.usedIn }}</span></p>
                  <ul class="skillset__links" role="list">
                    {% for uid in item.used %}
                      {% set col = columns | byId(uid) %}
                      <li style="--i: {{ loop.index0 }}">
                        {% if col.href %}
                          <a href="{{ col.href }}"{% if col.external %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ col.name }}{% if col.external %}{{ icon.arrowUpRight(12) }}{% endif %}</a>
                        {% else %}
                          <span>{{ col.name }}</span>
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      </section>

      <!-- ─── Contact ─── -->
      <section id="contact" class="contact" aria-labelledby="contact-title">
        <div class="contact__inner wrap">
          <p class="label">{{ t.contact.label }}</p>
          <h2 class="contact__title" id="contact-title">{{ t.contact.title }}</h2>
          <p class="contact__lede">{{ t.contact.text }}</p>
          {{ contact.contactBlock(t, site) }}
          {# The arrow is glued to the last word, so a wrapped line never leaves it alone. #}
          {% set words = t.contact.freelance.split(" ") %}
          <a class="contact__freelance" href="/freelance/">{{ words.slice(0, -1).join(" ") }} <span class="nowrap">{{ words | last }}{{ icon.arrowRight(14) }}</span></a>
        </div>
      </section>
    </main>

    {% include "partials/footer.njk" %}

    <script type="module" src="{{ '/js/main.js' | versioned }}"></script>
  </body>
</html>
