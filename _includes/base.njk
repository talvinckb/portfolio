{% set t = fr if lang == 'fr' else en %}
{% set pageTitle = t.meta.title %}
{% set pageDescription = t.meta.description %}
{% set pageUrl = site.baseUrl + t.urlPrefix %}
{% set pageImage = site.baseUrl + ((t.meta.ogImage | default(site.ogImage)) | versioned) %}
{% set pageImageAlt = t.meta.ogImageAlt %}
{% set pageType = "website" %}
{% set anchorBase = "" %}
{% set homeUrl = t.urlPrefix %}
{% set altUrl = t.altUrl %}

{% set featured = t.projects.items | selectattr("featured") %}
{% set others = t.projects.items | rejectattr("featured") %}
{% set count = featured | length %}

{% import "partials/icons.njk" as icon %}
{% import "partials/contact-actions.njk" as contact %}

{# Two-digit index: 1 → "01". #}
{% macro two(n) %}{{ "0" if n < 10 }}{{ n }}{% endmacro %}

<!DOCTYPE html>
<html lang="{{ lang }}">
  <head>
    {% include "partials/theme-init.njk" %}
    {% include "partials/head.njk" %}
  </head>

  <body>
    {% include "partials/nav.njk" %}

    <main id="main">
      <!-- ─── Hero ─── -->
      <section class="hero wrap" aria-labelledby="hero-name">
        <div class="hero__meta">
          <p>{{ t.hero.role }}</p>
          <p class="status"><span class="status__dot" aria-hidden="true"></span>{{ t.hero.status }}</p>
        </div>

        {# Each letter rises on its own; the second line starts while the
           first is still moving. Screen readers get the plain name. #}
        <h1 class="hero__name" id="hero-name">
          <span class="visually-hidden">{{ t.hero.name }}</span>
          {% for word in t.hero.name.split(" ") %}
            {% set line = loop.index0 %}
            <span class="hero__line" aria-hidden="true">{% for ch in word.split("") %}<span class="hero__ch" style="--i: {{ loop.index0 + line * 4 }}">{{ ch }}</span>{% endfor %}</span>
          {% endfor %}
        </h1>

        <div class="hero__row">
          <p class="hero__lead"><strong>{{ t.hero.leadStrong }}</strong> {{ t.hero.lead }}</p>
          <div class="actions">
            <a href="#work" class="btn btn--accent">{{ t.hero.ctaWork }}{{ icon.arrowDown(16, "icon icon--down") }}</a>
            <a href="#contact" class="btn btn--line">{{ t.hero.ctaContact }}</a>
          </div>
        </div>
      </section>

      <!-- ─── Strip: the six projects, one open at a time ─── -->
      <section class="strip-wrap wrap" aria-label="{{ t.projects.stripLabel }}">
        <div class="strip" data-strip>
          {% for p in featured %}
            <a class="panel{{ ' is-open' if loop.first }}" href="#p-{{ p.id }}" style="--i: {{ loop.index0 }}; --focus: {{ p.focus | default('50%') }}">
              {# Same light/dark pair as the cards, picked at parse time. #}
              <picture>
                <source
                  data-theme-source="light"
                  media="(prefers-color-scheme: light)"
                  srcset="{{ (p.thumbnailLight | default(p.thumbnail)) | versioned }}"/>
                <img src="{{ p.thumbnail | versioned }}" alt="" width="1600" height="900"/>
              </picture>
              <span class="panel__num" aria-hidden="true">{{ two(loop.index) }}</span>
              <span class="panel__label" aria-hidden="true">{{ p.name }}</span>
              <span class="panel__go" aria-hidden="true">{{ icon.arrowDown(15) }}</span>
              <span class="panel__info">
                <span class="panel__name">{{ p.name }}</span>
                <span class="panel__short">{{ p.short }}</span>
              </span>
            </a>
          {% endfor %}
        </div>
      </section>

      <!-- ─── Work ─── -->
      <section id="work" class="section wrap" aria-labelledby="work-title">
        <h2 class="section__title" id="work-title">{{ t.projects.title }}<sup class="section__count">{{ two(count) }}</sup></h2>

        {# Cards stack as the page scrolls; main.js shrinks the one being covered. #}
        <div class="stack" data-stack data-cursor-label="{{ t.projects.cursor }}">
          {% for p in featured %}
            {% set projectUrl = t.urlPrefix + "projects/" + p.id + "/" %}
            <article class="card" id="p-{{ p.id }}" style="--i: {{ loop.index0 }}" aria-labelledby="card-{{ p.id }}">
              <div class="card__inner">
                <div class="card__text">
                  <p class="card__meta">
                    <span><b>{{ two(loop.index) }}</b> / {{ two(count) }}</span>
                    <span>{{ p.period }} · {{ t.projects.pair if p.team == 2 else t.projects.teamOf + " " + p.team }}</span>
                  </p>
                  <p class="card__name">{{ p.name }}</p>
                  <h3 class="card__title" id="card-{{ p.id }}">{{ p.title }}</h3>
                  <p class="card__tagline">{{ p.tagline | highlight(p.highlights) | safe }}</p>
                  <ul class="tags" role="list">
                    {% for s in p.stack %}<li>{{ s }}</li>{% endfor %}
                  </ul>
                  <div class="card__links">
                    <a class="btn btn--ink" href="{{ projectUrl }}">{{ t.projects.read }}{{ icon.arrowRight(16, "icon icon--right") }}</a>
                    {% if p.github %}
                      <a class="link" href="{{ p.github }}" target="_blank" rel="noopener noreferrer">{{ t.projects.sourceCode }}{{ icon.arrowUpRight(13) }}</a>
                    {% else %}
                      <span class="card__private">{{ t.projects.privateRepo }}</span>
                    {% endif %}
                  </div>
                </div>

                {# The visual repeats the case-study link for the pointer only. #}
                <a class="card__media" href="{{ projectUrl }}" tabindex="-1" aria-hidden="true" data-cursor>
                  {# The light variant is chosen at parse time: swapping it in JS
                     after the first paint would make the visual flash. #}
                  <picture>
                    <source
                      data-theme-source="light"
                      media="(prefers-color-scheme: light)"
                      srcset="{{ (p.thumbnailLight | default(p.thumbnail)) | versioned }}"/>
                    <img
                      src="{{ p.thumbnail | versioned }}"
                      alt=""
                      width="1600" height="900"
                      loading="lazy" decoding="async"/>
                  </picture>
                </a>
              </div>
            </article>
          {% endfor %}
        </div>

        <div class="others">
          <h3 class="label">{{ t.projects.secondaryTitle }}</h3>
          <ul class="others__list" role="list">
            {% for p in others %}
              <li class="other">
                <h4 class="other__name">{{ p.name }}</h4>
                <p class="other__tagline">{{ p.tagline }}</p>
                {% if p.repoNote %}<p class="other__note">{{ p.repoNote }}</p>{% endif %}
                <p class="other__stack">{{ p.stack | join(" · ") }}</p>
                {% if p.github %}
                  <a class="link" href="{{ p.github }}" target="_blank" rel="noopener noreferrer">{{ t.projects.publicRepo }}{{ icon.arrowUpRight(13) }}</a>
                {% else %}
                  <span class="other__private">{{ t.projects.privateRepo }}</span>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>
      </section>

      <!-- ─── Background ─── -->
      <section id="background" class="section wrap" aria-labelledby="background-title">
        <h2 class="section__title" id="background-title">{{ t.background.title }}</h2>

        <div class="path">
          <div class="path__group">
            <div class="path__aside">
              <h3 class="path__title">{{ t.background.experienceTitle }}</h3>
              <p class="path__count">{{ two(t.background.experiences | length) }}</p>
            </div>
            <ol class="path__list" role="list">
              {% for exp in t.background.experiences %}
                {% set when = exp.period.split(" — ") %}
                <li class="row">
                  <p class="row__when"><span>{{ when[0] }}</span>{% if when[1] %}<span>{{ when[1] }}</span>{% endif %}</p>
                  <div class="row__main">
                    <h4 class="row__org">{{ exp.company }}</h4>
                    <p class="row__role">{{ exp.title }}{% if exp.note %}, {{ exp.note }}{% endif %}</p>
                    <p class="row__desc">{{ exp.description }}</p>
                    <ul class="row__tags" role="list">
                      {% for tag in exp.tags %}<li>{{ tag }}</li>{% endfor %}
                    </ul>
                  </div>
                  <p class="row__side">
                    {% if loop.first %}
                      <span class="badge badge--live"><span class="badge__dot" aria-hidden="true"></span>{{ t.background.now }}</span>
                    {% else %}
                      <span class="badge">{{ exp.type }}</span>
                    {% endif %}
                  </p>
                </li>
              {% endfor %}
            </ol>
          </div>

          <div class="path__group">
            <div class="path__aside">
              <h3 class="path__title">{{ t.background.educationTitle }}</h3>
              <p class="path__count">{{ two(t.background.education | length) }}</p>
            </div>
            <div>
              <ol class="path__list" role="list">
                {% for edu in t.background.education %}
                  {% set when = edu.period.split(" — ") %}
                  <li class="row">
                    <p class="row__when"><span>{{ when[0] }}</span>{% if when[1] %}<span>{{ when[1] }}</span>{% endif %}</p>
                    <div class="row__main">
                      <h4 class="row__org">{{ edu.short | default(edu.institution) }}</h4>
                      <p class="row__role">{{ edu.degree }}</p>
                      {% if edu.description %}
                        <p class="row__desc">{{ edu.description }}</p>
                      {% elif edu.short %}
                        <p class="row__desc">{{ edu.institution }}</p>
                      {% endif %}
                    </div>
                    <p class="row__side"><span class="badge">{{ edu.location }}</span></p>
                  </li>
                {% endfor %}
              </ol>
              <p class="path__extras">
                <span class="label">{{ t.background.extrasTitle }}</span>{% for item in t.background.extras %}<span>{{ item }}</span>{% endfor %}
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ─── Skills ─── -->
      <section id="skills" class="section wrap" aria-labelledby="skills-title">
        <h2 class="section__title" id="skills-title">{{ t.skills.title }}</h2>

        <div class="skills" data-skills>
          <div class="skills__groups">
            {% for group in t.skills.groups %}
              <div class="skills__group">
                <h3 class="label">{{ group.category }}</h3>
                <ul class="skills__list" role="list">
                  {% for item in group.items %}
                    <li>
                      {% if item.used | length %}
                        <button class="skill" type="button" aria-pressed="false" aria-controls="skills-uses" data-skill="{{ item.name | slugify }}">{{ item.name }}</button>
                      {% else %}
                        <span class="skill skill--static">{{ item.name }}</span>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endfor %}
          </div>

          {# One prerendered list per skill; the script shows the chosen one. #}
          <div class="skills__uses" id="skills-uses" aria-live="polite">
            {% for group in t.skills.groups %}
              {% for item in group.items %}
                {% if item.used | length %}
                  <div class="skills__use" data-uses="{{ item.name | slugify }}" hidden>
                    <p class="skills__name">{{ item.name }}<span> · {{ t.skills.usedIn }}</span></p>
                    <ul class="skills__links" role="list">
                      {% for uid in item.used %}
                        {% set p = t.projects.items | byId(uid) %}
                        {% set exp = t.background.experiences | byId(uid) %}
                        <li style="--i: {{ loop.index0 }}">
                          {% if p and p.featured %}
                            <a href="#p-{{ p.id }}">{{ p.name }}</a>
                          {% elif p and p.github %}
                            <a href="{{ p.github }}" target="_blank" rel="noopener noreferrer">{{ p.name }}{{ icon.arrowUpRight(12) }}</a>
                          {% elif p %}
                            <span>{{ p.name }}</span>
                          {% elif exp %}
                            <a href="#background">{{ exp.company }}</a>
                          {% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                {% endif %}
              {% endfor %}
            {% endfor %}
          </div>
        </div>
      </section>

      <!-- ─── Contact ─── -->
      <section id="contact" class="contact" aria-labelledby="contact-title">
        <div class="contact__inner wrap">
          <p class="label">{{ t.contact.label }}</p>
          <h2 class="contact__title" id="contact-title">{{ t.contact.title }}</h2>
          <p class="contact__lede">{{ t.contact.text }}</p>
          {{ contact.contactBlock(t, site) }}
          <a class="contact__freelance" href="/freelance/">{{ t.contact.freelance }}{{ icon.arrowRight(14) }}</a>
        </div>
      </section>
    </main>

    {% include "partials/footer.njk" %}

    <script type="module" src="{{ '/js/main.js' | versioned }}"></script>
  </body>
</html>
