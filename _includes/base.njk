{% set t = fr if lang == 'fr' else en %}
{% set frUrl = "/" %}
{% set enUrl = "/en/" %}
{% set pageTitle = t.meta.title %}
{% set pageDescription = t.meta.description %}
{% set pageUrl = site.baseUrl + t.urlPrefix %}
{% set pageImage = site.baseUrl + (t.meta.ogImage | default(site.ogImage)) %}
{% set pageImageAlt = site.name + " — " + t.meta.jobTitle %}
{% set pageType = "website" %}
{% set anchorBase = "" %}
{% set homeUrl = t.urlPrefix %}
{% set altUrl = t.altUrl %}

{% import "partials/icons.njk" as icon %}
{% import "partials/contact-actions.njk" as contact %}

<!DOCTYPE html>
<html lang="{{ lang }}" data-theme="dark">
  <head>
    <script>
      // Applied before first paint to avoid a flash of the wrong theme.
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored !== "light" && stored !== "dark") {
            stored = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
          }
          document.documentElement.setAttribute("data-theme", stored);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
    {% include "partials/head.njk" %}
  </head>

  <body>
    {% include "partials/nav.njk" %}

    <main id="main">
      <!-- ─── Hero ─── -->
      <section id="hero" class="hero">
        <div class="container hero__inner">
          <p class="hero__greeting">{{ t.hero.greeting }}</p>
          <h1 class="hero__name">{{ t.hero.name }}</h1>
          <p class="hero__headline">{{ t.hero.headline }}</p>
          <p class="hero__status"><span class="hero__status-dot" aria-hidden="true"></span>{{ t.hero.status }}</p>

          <div class="hero__actions">
            {{ contact.actions(t, site, true) }}
          </div>
        </div>

        <a href="#about" class="hero__scroll-indicator" aria-label="{{ t.a11y.scrollDown }}">
          {{ icon.chevronDown() }}
        </a>
      </section>

      <!-- ─── About ─── -->
      <section id="about" class="section">
        <div class="container">
          <h2 class="section__title">{{ t.about.title }}</h2>
          <div class="section__divider" aria-hidden="true"></div>

          <p class="about__intro">{{ t.about.intro }}</p>

          <ol class="about__education" role="list">
            {% for edu in t.about.education %}
              <li class="edu-item">
                <div class="edu-item__header">
                  <span class="edu-item__institution">{{ edu.institution }}</span>
                  <span class="edu-item__location">{{ edu.location }}</span>
                </div>
                <p class="edu-item__degree">{{ edu.degree }}</p>
                <p class="edu-item__period">{{ edu.period }}</p>
                {% if edu.description %}
                  <p class="edu-item__description">{{ edu.description }}</p>
                {% endif %}
              </li>
            {% endfor %}
          </ol>

          <div class="about__certifications">
            {% for cert in t.about.certifications %}
              <p><span class="cert-label">{{ cert.label }}</span>{{ t.about.certSeparator }}{{ cert.value }}</p>
            {% endfor %}
          </div>
        </div>
      </section>

      <!-- ─── Experience ─── -->
      <section id="experience" class="section section--alt">
        <div class="container">
          <h2 class="section__title">{{ t.experiences.title }}</h2>
          <div class="section__divider" aria-hidden="true"></div>

          <ol class="experience__list" role="list">
            {% for exp in t.experiences.items %}
              <li class="exp-item">
                <div class="exp-item__meta">
                  <span class="exp-item__period">{{ exp.period }}</span>
                  <span class="exp-item__type">{{ exp.type }}</span>
                </div>
                <div class="exp-item__content">
                  <h3 class="exp-item__title">{{ exp.title }}</h3>
                  <p class="exp-item__company">{{ exp.company }}</p>
                  <p class="exp-item__description">{{ exp.description }}</p>
                  <ul class="exp-item__tags tag-list" role="list">
                    {% for tag in exp.tags %}
                      <li class="tag">{{ tag }}</li>
                    {% endfor %}
                  </ul>
                </div>
              </li>
            {% endfor %}
          </ol>
        </div>
      </section>

      <!-- ─── Projects ─── -->
      <section id="projects" class="section">
        <div class="container">
          <h2 class="section__title">{{ t.projects.title }}</h2>
          <div class="section__divider" aria-hidden="true"></div>

          <ul class="projects__grid" role="list">
            {% for p in t.projects.items %}
              {% if p.featured %}
                {% set projectUrl = t.urlPrefix + "projects/" + p.id + "/" %}
                <li>
                  <article class="project-card" id="project-{{ p.id }}">
                    <div class="project-card__thumbnail">
                      <img
                        src="{{ p.thumbnail }}"
                        data-src-dark="{{ p.thumbnail }}"
                        data-src-light="{{ p.thumbnailLight | default(p.thumbnail) }}"
                        alt="{{ t.a11y.projectPreview }} {{ p.name }}"
                        width="800" height="450"
                        loading="lazy" decoding="async"/>
                    </div>

                    <div class="project-card__body">
                      <div class="project-card__header">
                        <span class="project-card__name">{{ p.name }}</span>
                        {% if p.period %}
                          <span class="project-card__period">{{ p.period }}</span>
                        {% endif %}
                      </div>

                      <h3 class="project-card__title">
                        <a class="project-card__link" href="{{ projectUrl }}">{{ p.title }}</a>
                      </h3>

                      <p class="project-card__tagline">{{ p.tagline }}</p>

                      <ul class="project-card__stack tag-list" role="list">
                        {% for s in p.stack %}
                          <li class="tag tag--static">{{ s }}</li>
                        {% endfor %}
                      </ul>

                      <div class="project-card__actions">
                        <span class="project-card__cta">
                          {{ t.projects.viewProject }}{{ icon.arrowRight(14) }}
                        </span>
                        {% if p.github %}
                          <a class="project-card__code" href="{{ p.github }}" target="_blank" rel="noopener noreferrer" aria-label="{{ t.a11y.sourceCode }} {{ p.name }}">
                            {{ icon.github(14) }}<span>{{ t.projects.codeLabel }}</span>
                          </a>
                        {% endif %}
                      </div>
                    </div>
                  </article>
                </li>
              {% endif %}
            {% endfor %}
          </ul>

          <!-- Secondary projects -->
          <h3 class="projects__sub-title">{{ t.projects.secondaryTitle }}</h3>
          <ul class="projects__grid projects__grid--secondary" role="list">
            {% for p in t.projects.items %}
              {% if not p.featured %}
                <li>
                  <article class="project-card project-card--secondary{{ ' is-linked' if p.github }}" id="project-{{ p.id }}">
                    <div class="project-card__body">
                      <div class="project-card__header">
                        <span class="project-card__name">{{ p.name }}</span>
                        <span class="project-card__kind project-card__kind--{{ p.kind }}">{{ t.projects.labels[p.kind] }}</span>
                      </div>

                      <h4 class="project-card__title">
                        {% if p.github %}
                          <a class="project-card__link" href="{{ p.github }}" target="_blank" rel="noopener noreferrer">{{ p.title }}</a>
                        {% else %}
                          {{ p.title }}
                        {% endif %}
                      </h4>

                      <p class="project-card__tagline">{{ p.tagline }}</p>

                      <ul class="project-card__stack tag-list" role="list">
                        {% for s in p.stack %}
                          <li class="tag tag--static">{{ s }}</li>
                        {% endfor %}
                      </ul>

                      {% if p.github %}
                        <div class="project-card__actions">
                          <span class="project-card__cta project-card__cta--code">
                            {{ icon.github(14) }}{{ t.projects.codeLabel }}
                          </span>
                        </div>
                      {% endif %}
                    </div>
                  </article>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </section>

      <!-- ─── Skills ─── -->
      <section id="skills" class="section section--alt">
        <div class="container">
          <h2 class="section__title">{{ t.skills.title }}</h2>
          <div class="section__divider" aria-hidden="true"></div>

          <ul class="skills__grid" role="list">
            {% for group in t.skills.groups %}
              <li class="skill-group">
                <h3 class="skill-group__title">{{ group.category }}</h3>
                <ul class="skill-group__items tag-list" role="list">
                  {% for item in group.items %}
                    {% if item | isFilterable(t) %}
                      <li>
                        <button type="button" class="tag tag--filter" data-skill="{{ item | lower }}" aria-pressed="false">{{ item }}</button>
                      </li>
                    {% else %}
                      <li class="tag">{{ item }}</li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </li>
            {% endfor %}
          </ul>
        </div>
      </section>

      <!-- ─── Contact ─── -->
      <section id="contact" class="section">
        <div class="container contact__inner">
          <h2 class="section__title">{{ t.contact.title }}</h2>
          <div class="section__divider" aria-hidden="true"></div>

          <p class="contact__text">{{ t.contact.text }}</p>

          <div class="contact__links">
            {{ contact.actions(t, site, false) }}
          </div>
        </div>
      </section>
    </main>

    {% include "partials/footer.njk" %}

    <script type="module" src="/js/main.js"></script>
  </body>
</html>
