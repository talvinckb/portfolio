{% set t = fr if lang == 'fr' else en %}
{% set frUrl = "/" %}
{% set enUrl = "/en/" %}
{% set pageTitle = t.meta.title %}
{% set pageDescription = t.meta.description %}
{% set pageUrl = site.baseUrl + t.urlPrefix %}
{% set pageImage = site.baseUrl + (t.meta.ogImage | default(site.ogImage)) %}
{% set pageImageAlt = site.name + " — " + t.meta.jobTitle %}
{% set pageType = "website" %}
{% set anchorBase = "" %}
{% set homeUrl = t.urlPrefix %}
{% set altUrl = t.altUrl %}

{% import "partials/icons.njk" as icon %}
{% import "partials/contact-actions.njk" as contact %}

<!DOCTYPE html>
<html lang="{{ lang }}" data-theme="light">
  <head>
    <script>
      // Applied before first paint to avoid a flash of the wrong theme.
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          if (stored !== "light" && stored !== "dark") {
            stored = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          document.documentElement.setAttribute("data-theme", stored);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    {% include "partials/head.njk" %}
  </head>

  <body>
    {% include "partials/nav.njk" %}

    <main id="main">
      <!-- ─── Hero ─── -->
      <section class="hero">
        <div class="wrap hero__inner">
          <p class="hero__eyebrow">
            <span class="hero__mark" aria-hidden="true"></span>
            <span>{{ t.hero.name }}</span>
            <span aria-hidden="true">—</span>
            <span>{{ t.hero.location }}</span>
          </p>

          <h1 class="hero__statement">{{ t.hero.statement }}</h1>

          <div class="hero__cols">
            <p class="hero__intro">{{ t.hero.intro }}</p>

            <div class="hero__cta">
              <p class="hero__status">
                <span class="hero__status-mark" aria-hidden="true"></span>{{ t.hero.status }}
              </p>

              {{ contact.heroActions(t, site) }}
            </div>
          </div>
        </div>

        <ul class="facts wrap" role="list" aria-label="{{ t.a11y.keyFigures }}">
          {% for fact in t.hero.facts %}
            <li class="fact">
              <p class="fact__value">{{ fact.value }}</p>
              <p class="fact__label">{{ fact.label }}</p>
            </li>
          {% endfor %}
        </ul>
      </section>

      <!-- ─── Work ─── -->
      <section id="work" class="section">
        <div class="wrap">
          <header class="section__head">
            <p class="section__index"><span aria-hidden="true">{{ t.projects.index }}</span>{{ t.projects.label }}</p>
            <h2 class="section__title">{{ t.projects.title }}</h2>
            <p class="section__lede">{{ t.projects.lede }}</p>
          </header>

          <ul class="work-grid" role="list">
            {% for p in t.projects.items %}
              {% if p.featured %}
                {% set projectUrl = t.urlPrefix + "projects/" + p.id + "/" %}
                <li>
                  <article class="work-card">
                    <div class="work-card__media">
                      <img
                        src="{{ p.thumbnail }}"
                        data-src-dark="{{ p.thumbnail }}"
                        data-src-light="{{ p.thumbnailLight | default(p.thumbnail) }}"
                        alt="{{ t.a11y.projectPreview }} {{ p.name }}"
                        width="800" height="450"
                        loading="lazy" decoding="async"/>
                    </div>

                    <p class="work-card__meta">
                      <span class="work-card__name">{{ p.name }}</span>
                      {% if p.period %}<span class="work-card__period">{{ p.period }}</span>{% endif %}
                      {% if p.github %}
                        <a class="work-card__code" href="{{ p.github }}" target="_blank" rel="noopener noreferrer" aria-label="{{ t.a11y.sourceCode }} {{ p.name }}">
                          {{ icon.github(14) }}
                        </a>
                      {% endif %}
                    </p>

                    <h3 class="work-card__title">
                      <a href="{{ projectUrl }}">{{ p.title }}</a>
                    </h3>

                    <p class="work-card__tagline">{{ p.tagline }}</p>

                    <p class="work-card__stack">{{ p.stack | join(" · ") }}</p>

                    <p class="work-card__cta" aria-hidden="true">
                      {{ t.projects.viewProject }}{{ icon.arrowRight(14) }}
                    </p>
                  </article>
                </li>
              {% endif %}
            {% endfor %}
          </ul>

          <h3 class="subhead">{{ t.projects.secondaryTitle }}</h3>

          <ul class="side-list" role="list">
            {% for p in t.projects.items %}
              {% if not p.featured %}
                <li class="side-item{{ ' side-item--linked' if p.github }}">
                  <p class="side-item__aside">
                    <span class="side-item__name">{{ p.name }}</span>
                    <span class="side-item__kind">{{ t.projects.labels[p.kind] }}</span>
                  </p>

                  <div class="side-item__body">
                    <h4 class="side-item__title">
                      {% if p.github %}
                        <a href="{{ p.github }}" target="_blank" rel="noopener noreferrer">{{ p.title }}</a>
                      {% else %}
                        {{ p.title }}
                      {% endif %}
                    </h4>
                    <p class="side-item__tagline">{{ p.tagline }}</p>
                    <p class="side-item__stack">{{ p.stack | join(" · ") }}</p>
                  </div>

                  {% if p.github %}
                    <span class="side-item__arrow" aria-hidden="true">{{ icon.arrowUpRight(16) }}</span>
                  {% endif %}
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </section>

      <!-- ─── Background ─── -->
      <section id="background" class="section section--rule">
        <div class="wrap">
          <header class="section__head">
            <p class="section__index"><span aria-hidden="true">{{ t.background.index }}</span>{{ t.background.label }}</p>
            <h2 class="section__title">{{ t.background.title }}</h2>
          </header>

          <h3 class="subhead subhead--flush">{{ t.background.experienceTitle }}</h3>
          <ol class="entries" role="list">
            {% for exp in t.background.experiences %}
              <li class="entry">
                <p class="entry__period">{{ exp.period }}</p>
                <div class="entry__body">
                  <h4 class="entry__title">
                    {{ exp.title }}<span class="entry__type">{{ exp.type }}</span>
                  </h4>
                  <p class="entry__org">{{ exp.company }}</p>
                  <p class="entry__desc">{{ exp.description }}</p>
                  <p class="entry__tags">{{ exp.tags | join(" · ") }}</p>
                </div>
              </li>
            {% endfor %}
          </ol>

          <h3 class="subhead">{{ t.background.educationTitle }}</h3>
          <ol class="entries" role="list">
            {% for edu in t.background.education %}
              <li class="entry">
                <p class="entry__period">{{ edu.period }}</p>
                <div class="entry__body">
                  <h4 class="entry__title">
                    {{ edu.institution }}<span class="entry__type">{{ edu.location }}</span>
                  </h4>
                  <p class="entry__org entry__org--plain">{{ edu.degree }}</p>
                  {% if edu.description %}
                    <p class="entry__desc">{{ edu.description }}</p>
                  {% endif %}
                </div>
              </li>
            {% endfor %}
          </ol>

          <h3 class="subhead">{{ t.background.extrasTitle }}</h3>
          <ul class="extras" role="list">
            {% for extra in t.background.extras %}
              <li>{{ extra }}</li>
            {% endfor %}
          </ul>
        </div>
      </section>

      <!-- ─── Skills ─── -->
      <section id="skills" class="section section--rule">
        <div class="wrap">
          <header class="section__head">
            <p class="section__index"><span aria-hidden="true">{{ t.skills.index }}</span>{{ t.skills.label }}</p>
            <h2 class="section__title">{{ t.skills.title }}</h2>
          </header>

          <ul class="skills" role="list">
            {% for group in t.skills.groups %}
              <li class="skill-col">
                <h3 class="skill-col__title">{{ group.category }}</h3>
                <ul class="skill-col__items" role="list">
                  {% for item in group.items %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
              </li>
            {% endfor %}
          </ul>
        </div>
      </section>

      <!-- ─── Contact ─── -->
      <section id="contact" class="section section--rule">
        <div class="wrap">
          <header class="section__head">
            <p class="section__index"><span aria-hidden="true">{{ t.contact.index }}</span>{{ t.contact.label }}</p>
            <h2 class="section__title section__title--display">{{ t.contact.title }}</h2>
            <p class="section__lede">{{ t.contact.text }}</p>
          </header>

          {{ contact.contactBlock(t, site) }}
        </div>
      </section>
    </main>

    {% include "partials/footer.njk" %}

    <script type="module" src="/js/main.js"></script>
  </body>
</html>
