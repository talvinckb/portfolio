{% set t = fr if lang == 'fr' else en %}
{% set frUrl = "/" %}
{% set enUrl = "/en/" %}
{% set pageTitle = t.meta.title %}
{% set pageDescription = t.meta.description %}
{% set pageUrl = site.baseUrl + t.urlPrefix %}
{% set pageImage = site.baseUrl + (t.meta.ogImage | default(site.ogImage)) %}
{% set pageImageAlt = site.name + " — " + t.meta.jobTitle %}
{% set pageType = "website" %}
{% set anchorBase = "" %}
{% set homeUrl = t.urlPrefix %}
{% set altUrl = t.altUrl %}

{% set featured = t.projects.items | selectattr("featured") %}
{% set others = t.projects.items | rejectattr("featured") %}

{% import "partials/icons.njk" as icon %}
{% import "partials/contact-actions.njk" as contact %}

<!DOCTYPE html>
<html lang="{{ lang }}">
  <head>
    {% include "partials/theme-init.njk" %}
    {% include "partials/head.njk" %}
  </head>

  <body>
    {% include "partials/nav.njk" %}

    <main id="main">
      <!-- ─── Hero ─── -->
      <section class="hero wrap">
        <div class="hero__text">
          <p class="status"><span class="status__dot" aria-hidden="true"></span>{{ t.hero.status }}</p>

          <p class="hero__kicker">{{ t.hero.name }} — {{ t.hero.kicker }}</p>
          <h1 class="hero__title">{{ t.hero.headline }}</h1>
          <p class="hero__intro">{{ t.hero.intro }}</p>

          {{ contact.heroActions(t, site, anchorBase) }}
        </div>

        {% if t.hero.photo %}
          {# A real detection: the box sits on the face in the portrait. #}
          {% set box = t.hero.photoBox %}
          <figure class="viewer hero__viewer">
            <div class="viewer__bar" aria-hidden="true">
              <span>cam_01 · {{ t.hero.photoSource }}</span><span>{{ t.hero.detections }}</span>
            </div>
            <div class="viewer__frame viewer__frame--portrait">
              <img src="{{ t.hero.photo }}" alt="{{ t.hero.photoAlt }}" width="800" height="1000" fetchpriority="high" decoding="async"/>
              <span class="detect" style="--x: {{ box.x }}%; --y: {{ box.y }}%; --w: {{ box.w }}%; --h: {{ box.h }}%;" aria-hidden="true">
                <span class="detect__label">{{ t.hero.detectionLabel }} · 0.99</span>
              </span>
            </div>
            <div class="viewer__bar" aria-hidden="true">
              <span>{{ t.hero.location }}</span><span>{{ t.hero.coords }}</span>
            </div>
          </figure>
        {% else %}
          {% set media = t.hero.media %}
          <figure class="viewer hero__viewer">
            <div class="viewer__bar" aria-hidden="true">
              <span>{{ media.source }}</span><span class="viewer__live">{{ media.rate }}</span>
            </div>
            <div class="viewer__frame">
              <video class="hero__video" poster="{{ media.poster }}" muted loop playsinline preload="none" aria-label="{{ media.alt }}" data-src="{{ media.video }}"></video>
            </div>
            <div class="viewer__bar" aria-hidden="true">
              {% for m in media.meta %}<span>{{ m }}</span>{% endfor %}
            </div>
          </figure>
        {% endif %}
      </section>

      <!-- ─── Work ─── -->
      <section id="work" class="section wrap">
        <header class="sec-head">
          <h2 class="sec-head__title"><span class="sec-head__num">{{ t.projects.index }}</span>{{ t.projects.title }}</h2>
          <p class="sec-head__aside">{{ featured | length }} {{ t.projects.count }}</p>
        </header>

        <ul class="work-grid" role="list">
          {% for p in featured %}
            {% set projectUrl = t.urlPrefix + "projects/" + p.id + "/" %}
            <li>
              <article class="work-card">
                {# The one detection box a card gets: on hover or focus, around the card itself. #}
                <span class="detect" aria-hidden="true">
                  <span class="detect__label">{{ p.id }} · 0.{{ 100 - loop.index }}</span>
                </span>

                <div class="work-card__media">
                  <img
                    src="{{ p.thumbnail }}"
                    data-src-dark="{{ p.thumbnail }}"
                    data-src-light="{{ p.thumbnailLight | default(p.thumbnail) }}"
                    alt=""
                    width="800" height="450"
                    loading="lazy" decoding="async"/>
                </div>

                <div class="work-card__body">
                  <p class="work-card__meta">{{ p.name }}{% if p.period %} · {{ p.period }}{% endif %}</p>
                  <h3 class="work-card__title">
                    <a href="{{ projectUrl }}">{{ p.title }}</a>
                  </h3>
                  <p class="work-card__tagline">{{ p.tagline }}</p>
                  <p class="work-card__stack">{{ p.stack | join(" · ") }}</p>
                </div>

                {% if p.github %}
                  <a class="work-card__code" href="{{ p.github }}" target="_blank" rel="noopener noreferrer" aria-label="{{ t.a11y.sourceCode }} {{ p.name }}" title="{{ t.projects.codeLabel }}">
                    {{ icon.github(16) }}
                  </a>
                {% endif %}
              </article>
            </li>
          {% endfor %}
        </ul>

        <header class="sub-head">
          <h3 class="sub-head__title">{{ t.projects.secondaryTitle }}</h3>
          <p class="sub-head__aside">{{ others | length }} · {{ t.projects.secondaryNote }}</p>
        </header>

        <ul class="other-list" role="list">
          {% for p in others %}
            <li class="other{{ ' other--linked' if p.github }}">
              <p class="other__name">{{ p.name }}</p>
              <div class="other__body">
                <h4 class="other__title">
                  {% if p.github %}
                    <a href="{{ p.github }}" target="_blank" rel="noopener noreferrer">{{ p.title }}</a>
                  {% else %}
                    {{ p.title }}
                  {% endif %}
                </h4>
                <p class="other__tagline">{{ p.tagline }}</p>
                {% if p.repoNote %}<p class="other__note">{{ p.repoNote }}</p>{% endif %}
              </div>
              <p class="other__stack">{{ p.stack | join(" · ") }}</p>
              <p class="other__repo">
                {% if p.github %}{{ t.projects.publicRepo }}{{ icon.arrowUpRight(13) }}{% else %}{{ t.projects.privateRepo }}{% endif %}
              </p>
            </li>
          {% endfor %}
        </ul>
      </section>

      <!-- ─── Background ─── -->
      <section id="background" class="section wrap">
        <header class="sec-head">
          <h2 class="sec-head__title"><span class="sec-head__num">{{ t.background.index }}</span>{{ t.background.title }}</h2>
        </header>

        <div class="timelines">
          <div>
            <h3 class="label">{{ t.background.experienceTitle }}</h3>
            <ol class="timeline" role="list">
              {% for exp in t.background.experiences %}
                <li class="timeline__item{{ ' timeline__item--current' if loop.first }}">
                  <p class="timeline__when">{{ exp.period }} · {{ exp.type }}</p>
                  <h4 class="timeline__title">{{ exp.company }} <span>— {{ exp.title }}</span></h4>
                  <p class="timeline__desc">{{ exp.description }}</p>
                  <p class="timeline__tags">{{ exp.tags | join(" · ") }}</p>
                </li>
              {% endfor %}
            </ol>
          </div>

          <div>
            <h3 class="label">{{ t.background.educationTitle }}</h3>
            <ol class="timeline" role="list">
              {% for edu in t.background.education %}
                <li class="timeline__item{{ ' timeline__item--current' if loop.first }}">
                  <p class="timeline__when">{{ edu.period }} · {{ edu.location }}</p>
                  <h4 class="timeline__title">{{ edu.institution }}</h4>
                  <p class="timeline__desc">{{ edu.degree }}{% if edu.description %}. {{ edu.description }}{% endif %}</p>
                </li>
              {% endfor %}
            </ol>

            <p class="extras">
              <span class="label">{{ t.background.extrasTitle }}</span>{{ t.background.extras | join(" · ") }}
            </p>
          </div>
        </div>
      </section>

      <!-- ─── Skills ─── -->
      <section id="skills" class="section wrap">
        <header class="sec-head">
          <h2 class="sec-head__title"><span class="sec-head__num">{{ t.skills.index }}</span>{{ t.skills.title }}</h2>
          <p class="sec-head__aside skills__hint" hidden>{{ t.skills.hint }}</p>
        </header>

        <div class="skills" data-skills>
          <div class="skills__groups">
            {% for group in t.skills.groups %}
              <div class="skills__group">
                <h3 class="skills__category">{{ group.category }}</h3>
                <ul class="chips" role="list">
                  {% for item in group.items %}
                    <li>
                      {% if item.used | length %}
                        <button class="chip" type="button" aria-pressed="false" aria-controls="skills-uses" data-skill="{{ item.name | slugify }}">{{ item.name }}</button>
                      {% else %}
                        <span class="chip chip--static">{{ item.name }}</span>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endfor %}
          </div>

          {# One prerendered list per skill; the script shows the chosen one. #}
          <div class="skills__uses" id="skills-uses" aria-live="polite" hidden>
            {% for group in t.skills.groups %}
              {% for item in group.items %}
                {% if item.used | length %}
                  <div class="skills__use" data-uses="{{ item.name | slugify }}" hidden>
                    <p class="label">{{ item.name }} — {{ t.skills.usedIn }}</p>
                    <ul class="skills__links" role="list">
                      {% for uid in item.used %}
                        {% set p = t.projects.items | byId(uid) %}
                        {% set exp = t.background.experiences | byId(uid) %}
                        <li>
                          {% if p and p.featured %}
                            <a href="{{ t.urlPrefix }}projects/{{ p.id }}/">{{ p.name }}</a>
                          {% elif p and p.github %}
                            <a href="{{ p.github }}" target="_blank" rel="noopener noreferrer">{{ p.name }}{{ icon.arrowUpRight(12) }}</a>
                          {% elif p %}
                            <span>{{ p.name }}</span>
                          {% elif exp %}
                            <a href="#background">{{ exp.company }}</a>
                          {% endif %}
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                {% endif %}
              {% endfor %}
            {% endfor %}
          </div>
        </div>
      </section>

      <!-- ─── Contact ─── -->
      <section id="contact" class="section wrap">
        <div class="contact">
          <div class="contact__text">
            <p class="contact__eyebrow">{{ t.contact.index }} — {{ t.contact.label }}</p>
            <h2 class="contact__title">{{ t.contact.title }}</h2>
            <p class="contact__lede">{{ t.contact.text }}</p>
          </div>

          {{ contact.contactBlock(t, site) }}
        </div>
      </section>
    </main>

    {% include "partials/footer.njk" %}

    <script type="module" src="/js/main.js"></script>
  </body>
</html>
